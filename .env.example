# ── Supabase (방명록/RSVP DB) ─────────────────────────────
# Supabase 프로젝트 > Settings > API
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── Cloudflare R2 (방명록 사진 원본 저장) ─────────────────
# Cloudflare 대시보드 > R2 > API 토큰 (S3 호환)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=wedding-guestbook

# R2 버킷의 공개 도메인 (r2.dev 활성화 후 표시되는 호스트, 프로토콜 제외)
NEXT_PUBLIC_MEDIA_HOST=pub-xxxxxxxx.r2.dev

# ── 사이트 ────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://dongjae-raewon.vercel.app

# Kakao Developers > 앱 > JavaScript 키 (웹 플랫폼 도메인 등록 필수)
NEXT_PUBLIC_KAKAO_JS_KEY=

# ── 관리자/운영 ───────────────────────────────────────────
# /admin 접근 비밀키 (긴 랜덤 문자열 권장: openssl rand -hex 24)
ADMIN_SECRET=
# Vercel Cron 인증 (Vercel 환경변수에 설정하면 cron 요청에 자동 첨부됨)
CRON_SECRET=
# IP 해시 솔트 (레이트리밋용, 아무 랜덤 문자열)
IP_HASH_SALT=
